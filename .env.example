# Example Environment Variables template for Exhibition Guru
# Copy this file to .env for local development or set these in Render Dashboard

SECRET_KEY=your_random_secret_key_here

# SMTP Email Settings
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_gmail_app_password
RECIPIENT_EMAIL=your_notifications_email@gmail.com
ENABLE_EMAIL=true
